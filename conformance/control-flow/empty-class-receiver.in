// @expect parse: ok
// @expect has-function: main
// @expect bytecode: executes
// @expect result: 42

class Empty {
    fn answer(a: Int, b: Int, c: Int, d: Int, e: Int, f: Int, g: Int, h: Int) -> Int {
        return a + b + c + d + e + f + g + h;
    }
}
fn main() -> Int {
    var empty: Empty = Empty {};
    return empty.answer(1, 2, 3, 4, 5, 6, 7, 14);
}
