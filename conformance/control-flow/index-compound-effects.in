// @expect parse: ok
// @expect has-function: main
// @expect bytecode: executes
// @expect result: 42

var calls: Int = 0;
fn index() -> Int { calls += 1; return 0; }
fn value() -> Int { calls += 1; return calls; }
fn main() -> Int {
    let values: [Int] = [20];
    index-modify-value-first(values, index(), value(), "+");
    return values[0] * 2;
}
