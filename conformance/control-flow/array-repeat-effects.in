// @expect parse: ok
// @expect has-function: main
// @expect bytecode: executes
// @expect result: 42

var calls: Int = 0;
fn step() -> Int { calls += 1; return calls; }
fn main() -> Int {
    var sum: Int = 0;
    for value in array-repeat(step(), 2) { sum += value; }
    for value in array-repeat(step(), 0) { sum += value; }
    if false && array-len(array-repeat(step(), 3)) > 0 { return 99; }
    while array-repeat(step(), 1)[0] < 4 { continue; }
    return sum + calls * 10;
}
