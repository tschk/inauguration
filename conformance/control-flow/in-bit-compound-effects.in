// @expect parse: ok
// @expect has-function: main
// @expect bytecode: executes
// @expect result: 42

var trace: Int = 0;
fn index() -> Int { trace = trace * 10 + 1; return 0; }
fn rhs(values: [Int]) -> Int {
    trace = trace * 10 + 2;
    values[0] = 0;
    return 2;
}
fn main() -> Int {
    var values: [Int] = [40];
    values[index()] ^= rhs(values);
    var flag: Bool = true;
    flag &= false;
    flag |= true;
    flag ^= false;
    var mask: Int = 63;
    mask &= 47;
    mask ^= 5;
    mask |= 0;
    if flag && mask == 42 && trace == 12 { return values[0]; }
    return 0;
}
