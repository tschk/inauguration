// @expect parse: ok
// @expect has-function: main
// @expect bytecode: executes
// @expect result: 42

var trace: Int = 0;
fn index() -> Int { trace = trace * 10 + 1; return 0; }
fn rhs(values: [Int]) -> Int {
    trace = trace * 10 + 2;
    values[0] = 40;
    return 2;
}
fn main() -> Int {
    var values: [Int] = [28];
    values[index()] += rhs(values);
    return values[0] + trace;
}
