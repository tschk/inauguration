// @expect parse: ok
// @expect has-function: main
// @expect bytecode: executes
// @expect result: 23

// Fixed-size array local with index read/write and break/continue.
fn main() -> Int {
    let arr = [3, 1, 4, 1, 5];
    let sum = 0;
    let i = 0;
    while i < 5 {
        if i == 3 {
            i += 1;
            continue;
        }
        sum += arr[i];
        i += 1;
    }
    arr[0] = 10;
    sum += arr[0];
    return sum;
}
